#!/bin/sh

set -e

xcode=$(cd "$(xcode-select -print-path)/../.." && pwd -P)
toolchain=$xcode/Contents/Developer/Toolchains/XcodeDefault.xctoolchain
if ! file -b "$toolchain/usr/bin/clang" | grep -q x86_64; then
	echo "make-sysroot: $xcode has no x86_64 code; install Xcode from" \
		"its universal .xip instead" >&2
	exit 1
fi

case $(uname -m) in
x86_64)
	cache=/System/Volumes/Preboot/Cryptexes/OS/System/Library/dyld
	;;
*)
	cache=/System/Volumes/Preboot/Cryptexes/Rosetta/System/Library/dyld
	;;
esac
if [ ! -e "$cache/dyld_shared_cache_x86_64" ] \
		&& [ ! -e "$cache/dyld_shared_cache_x86_64h" ]; then
	echo "make-sysroot: no x86_64 dyld shared cache in $cache" >&2
	exit 1
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

small=$work/small
mkdir -p "$small/System/Library/CoreServices" "$small/bin" "$small/usr/bin" \
	"$small/usr/lib" "$small/usr/share" "$small/private/etc" \
	"$small/private/var/db" "$small/private/var/select" \
	"$small/Library/Preferences"
cp /System/Library/CoreServices/SystemVersion.plist \
	"$small/System/Library/CoreServices/"
cp -RP /bin/sh /bin/bash /bin/echo /bin/ls "$small/bin/"
cp -RP /usr/bin/xcrun /usr/bin/xcode-select "$small/usr/bin/"
cp -RP /usr/lib/dyld /usr/lib/*.dylib "$small/usr/lib/"
cp -RP /usr/share/firmlinks "$small/usr/share/"
cp -RP /private/etc/passwd /private/etc/group "$small/private/etc/"
if [ -f /Library/Preferences/com.apple.dt.Xcode.plist ]; then
	cp /Library/Preferences/com.apple.dt.Xcode.plist \
		"$small/Library/Preferences/"
fi
ln -s /bin/bash "$small/private/var/select/sh"
ln -s /Applications/Xcode.app/Contents/Developer \
	"$small/private/var/db/xcode_select_link"
ln -s private/etc "$small/etc"
ln -s private/var "$small/var"
(cd "$small" && tar -c --no-acls --no-fflags --no-xattrs -f "$work/small.tar" .)

large=$work/large
mkdir -p "$large/System/Library/dyld" "$large/Applications"
for file in "$cache"/dyld_shared_cache_x86_64*; do
	case $file in
	*.atlas | *.map) ;;
	*) ln -s "$file" "$large/System/Library/dyld/" ;;
	esac
done
ln -s "$xcode" "$large/Applications/Xcode.app"

app=./Applications/Xcode.app/Contents
bin=$app/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin
lib=$app/Developer/Toolchains/XcodeDefault.xctoolchain/usr/lib
set -- \
	--exclude "$app/Applications" \
	--exclude "$app/Developer/Applications" \
	--exclude "$lib/swift" \
	--exclude "$lib/swift-5.0" \
	--exclude "$lib/swift-5.5" \
	--exclude "$lib/sourcekitdInProc.framework" \
	--exclude "$lib/MetalPerformanceShadersGraph_host.framework" \
	--exclude "$bin/swift-frontend" \
	--exclude "$bin/sourcekit-lsp" \
	--exclude "$bin/clangd" \
	--exclude "$bin/docc" \
	--exclude "$bin/coremlcompiler"
for platform in "$xcode"/Contents/Developer/Platforms/*.platform; do
	name=$(basename "$platform")
	if [ "$name" != MacOSX.platform ]; then
		set -- "$@" --exclude "$app/Developer/Platforms/$name"
	fi
done

cd "$large"
tar -c -H --no-acls --no-fflags --no-xattrs -f - "$@" $(find . -type l) \
	"@$work/small.tar"
